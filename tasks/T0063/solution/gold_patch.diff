+      const more = hits.length > 1 ? `（其它候选: ${hits.slice(1).join(", ")}）` : "";
+      return `路径段 "${missingSeg}" 疑似应为 "${best}"${more}。可尝试完整路径: ${fullPath}`;
+    }

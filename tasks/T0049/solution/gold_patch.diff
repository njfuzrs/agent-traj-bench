 /** 信号量：限流并发工具执行 */
 async function withConcurrencyLimit<T>(
   tasks: Array<() => Promise<T>>,
   limit: number,
+  opts?: ConcurrencyLimitOptions,
 ): Promise<PromiseSettledResult<T>[]> {
   const results: PromiseSettledResult<T>[] = new Array(tasks.length);
   let nextIdx = 0;
+  let stopped = false;
 

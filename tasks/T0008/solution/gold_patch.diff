+      }
     }
 
-    try {
-      const regex = new RegExp(pattern);
-      return regex.test(toolName);
-    } catch {
-      // 非法正则，当作精确匹配
+    // 第 1 档：空 / 通配符 → 全部匹配（上游已处理，这里兜底）
+    if (matcher === "" || matcher === "*") return true;
+
+    // 第 2 档：纯 [a-zA-Z0-9_|] → 精确匹配（含 | 走管道分隔精确列表）
+    if (/^[a-zA-Z0-9_|]+$/.test(matcher)) {

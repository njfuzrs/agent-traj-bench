+/** 序列化当前全部任务为可落盘的快照（深拷贝，隔离外部改动）。 */
+export function serializeStructuredTasks(): StructuredTask[] {
+  return getAllStructuredTasks().map((t) => ({
+    ...t,
+    blocks: [...t.blocks],
+    blockedBy: [...t.blockedBy],
+    metadata: { ...t.metadata },
+  }));
